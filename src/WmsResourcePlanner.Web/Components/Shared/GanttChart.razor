@using WmsResourcePlanner.Application.DTOs
@implements IDisposable
@inject IJSRuntime JS

<div class="gantt-scroll">
    <div class="gantt-container" style="width:@(TotalWidthPx + 220)px" id="@_containerId">
        <div class="gantt-header">
            <div class="gantt-header-label">@GroupHeader</div>
            <div class="gantt-header-track" style="width:@(TotalWidthPx)px">
                @foreach (var tick in MonthTicks())
                {
                    <div class="gantt-month-tick" style="left:@(tick.Left)px">@tick.Label</div>
                }
            </div>
        </div>
        @foreach (var group in GroupedRows())
        {
            @if (HasSubGrouping)
            {
                <div class="gantt-row gantt-group-header">
                    <div class="gantt-row-label" title="@group.PrimaryLabel">@group.PrimaryLabel</div>
                    <div class="gantt-row-track" style="width:@(TotalWidthPx)px"></div>
                </div>
            }
            @foreach (var row in group.Rows)
            {
                var laned = AssignLanes(row.Bars);
                var laneCount = laned.Count == 0 ? 1 : laned.Max(x => x.Lane) + 1;
                var trackHeight = RowVerticalPadding + laneCount * LaneHeight;
                <div class="gantt-row">
                    <div class="gantt-row-label @(HasSubGrouping ? "gantt-row-label-sub" : "")" title="@row.RowLabel">@row.RowLabel</div>
                    <div class="gantt-row-track" style="width:@(TotalWidthPx)px;height:@(trackHeight)px">
                        @foreach (var (bar, lane) in laned)
                        {
                            var left = DaysFromStart(bar.StartDate) * PxPerDay;
                            var width = Math.Max(8, (DaysFromStart(bar.EndDate) - DaysFromStart(bar.StartDate) + 1) * PxPerDay);
                            var top = RowVerticalPadding + lane * LaneHeight;
                            <div class="gantt-bar @(bar.Color ?? "filled")" data-id="@bar.Id"
                                 style="left:@(left)px;width:@(width)px;top:@(top)px"
                                 title="@bar.BarLabel (@bar.StartDate.ToString("MMM yyyy") - @bar.EndDate.ToString("MMM yyyy"))">
                                <span style="pointer-events:none">@bar.BarLabel@(string.IsNullOrEmpty(bar.SubLabel) ? "" : $" · {bar.SubLabel}")</span>
                                <div class="resize-handle"></div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<GanttBar> Bars { get; set; } = new();
    [Parameter, EditorRequired] public DateOnly HorizonStart { get; set; }
    [Parameter, EditorRequired] public DateOnly HorizonEnd { get; set; }
    [Parameter] public string GroupHeader { get; set; } = "Group";
    [Parameter] public double PxPerDay { get; set; } = 3.0;
    [Parameter] public EventCallback<(int Id, DateOnly Start, DateOnly End)> OnBarChanged { get; set; }

    private readonly string _containerId = $"gantt-{Guid.NewGuid():N}";
    private DotNetObjectReference<GanttChart>? _dotNetRef;
    private int TotalWidthPx => (int)((HorizonEnd.DayNumber - HorizonStart.DayNumber + 1) * PxPerDay);

    // Bars within the same group row are stacked into vertical "lanes" so
    // that overlapping date ranges never overlap visually - each lane gets
    // its own horizontal strip, which keeps every bar independently
    // clickable/draggable/resizable even when several bars for the same
    // group cover the same time period. This is the standard convention
    // for any Gantt view that supports live drag/resize editing.
    private const int LaneHeight = 32;
    private const int RowVerticalPadding = 6;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("wmsGantt.init", _containerId, _dotNetRef);
        }
    }

    private bool HasSubGrouping => Bars.Any(b => !string.IsNullOrEmpty(b.SubGroupLabel));

    /// <summary>
    /// Groups bars by their primary GroupLabel and, when any bar carries a
    /// SubGroupLabel (second-level "then by" grouping), further splits each
    /// primary group into nested sub-rows keyed by that sub-label. When no
    /// second-level grouping is active, each primary group is a single row
    /// (identical to the previous flat behaviour).
    /// </summary>
    private List<(string PrimaryLabel, List<(string RowLabel, List<GanttBar> Bars)> Rows)> GroupedRows()
    {
        var subGrouping = HasSubGrouping;
        var result = new List<(string, List<(string, List<GanttBar>)>)>();
        foreach (var g in Bars.GroupBy(b => b.GroupLabel).OrderBy(g => g.Key))
        {
            if (subGrouping)
            {
                var subRows = g.GroupBy(b => b.SubGroupLabel ?? "(none)")
                    .OrderBy(sg => sg.Key)
                    .Select(sg => (RowLabel: sg.Key, Bars: sg.ToList()))
                    .ToList();
                result.Add((g.Key, subRows));
            }
            else
            {
                result.Add((g.Key, new List<(string, List<GanttBar>)> { (g.Key, g.ToList()) }));
            }
        }
        return result;
    }

    private static List<(GanttBar Bar, int Lane)> AssignLanes(IEnumerable<GanttBar> bars)
    {
        var ordered = bars.OrderBy(b => b.StartDate).ThenBy(b => b.EndDate).ToList();
        var laneEndDates = new List<DateOnly>();
        var result = new List<(GanttBar, int)>(ordered.Count);
        foreach (var bar in ordered)
        {
            var lane = laneEndDates.FindIndex(end => end < bar.StartDate);
            if (lane == -1)
            {
                lane = laneEndDates.Count;
                laneEndDates.Add(bar.EndDate);
            }
            else
            {
                laneEndDates[lane] = bar.EndDate;
            }
            result.Add((bar, lane));
        }
        return result;
    }

    private int DaysFromStart(DateOnly d) => d.DayNumber - HorizonStart.DayNumber;

    private IEnumerable<(double Left, string Label)> MonthTicks()
    {
        var cursor = new DateOnly(HorizonStart.Year, HorizonStart.Month, 1);
        while (cursor <= HorizonEnd)
        {
            yield return (DaysFromStart(cursor) * PxPerDay, cursor.ToString("MMM-yy"));
            cursor = cursor.AddMonths(1);
        }
    }

    [JSInvokable]
    public async Task HandleBarChanged(int id, double leftPx, double widthPx)
    {
        if (!OnBarChanged.HasDelegate) return;
        var startOffset = (int)Math.Round(leftPx / PxPerDay);
        var lengthDays = Math.Max(1, (int)Math.Round(widthPx / PxPerDay));
        var newStart = HorizonStart.AddDays(startOffset);
        var newEnd = newStart.AddDays(lengthDays - 1);
        await OnBarChanged.InvokeAsync((id, newStart, newEnd));
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
