@page "/global-timeline"
@rendermode InteractiveServer
@inject WmsResourcePlanner.Application.Services.GanttService GanttService
@inject WmsResourcePlanner.Application.Interfaces.IAppDbContext Db
@inject WmsResourcePlanner.Application.Services.FilterStateService FilterState
@inject WmsResourcePlanner.Application.Services.HorizonService HorizonService
@using Microsoft.EntityFrameworkCore
@using WmsResourcePlanner.Domain.Entities
@using WmsResourcePlanner.Application.DTOs

<PageTitle>Global Timeline</PageTitle>
<h1>Global Timeline</h1>
<p>A program-wide view of every resource-plan allocation. Group by any dimension and filter to focus on a
slice of the plan (SPEC.md section 48). This view is read-only; edit dates on the Resource Plan grid or the
Resource Gantt.</p>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <div class="gantt-toolbar" style="flex-wrap:wrap;gap:0.5rem">
        <label>Scenario:
            <select @bind="FilterState.ScenarioId" @bind:after="LoadAsync">
                @foreach (var s in _scenarios) { <option value="@s.Id">@s.Name</option> }
            </select>
        </label>
        <label>Group by:
            <select @bind="FilterState.GroupBy">
                <option value="Template">Template</option>
                <option value="Phase">Template Phase</option>
                <option value="Workstream">Workstream</option>
                <option value="Team">Team</option>
                <option value="Role">Role</option>
                <option value="Person">Person</option>
            </select>
        </label>
        <label>Then by:
            <select @bind="FilterState.GroupBy2">
                <option value="None">(none)</option>
                <option value="Template">Template</option>
                <option value="Phase">Template Phase</option>
                <option value="Workstream">Workstream</option>
                <option value="Team">Team</option>
                <option value="Role">Role</option>
                <option value="Person">Person</option>
            </select>
        </label>
        <label>Template: <input @bind="FilterState.TemplateFilter" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Workstream: <input @bind="FilterState.WorkstreamFilter" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Team: <input @bind="FilterState.TeamFilter" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Role: <input @bind="FilterState.RoleFilter" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Person: <input @bind="FilterState.PersonFilter" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label><input type="checkbox" @bind="FilterState.OpenDemandOnly" /> Open demand only</label>
    </div>

    <p>Showing @FilteredBars().Count of @_allLines.Count allocation(s).</p>

    @if (FilteredBars().Count == 0)
    {
        <p>No allocations match the current filters.</p>
    }
    else
    {
        <GanttChart Bars="FilteredBars()" HorizonStart="_horizonStart" HorizonEnd="_horizonEnd" GroupHeader="@FilterState.GroupBy" PxPerDay="2.0" />
    }
}

@code {
    private bool _loading = true;
    private List<PlanningScenario> _scenarios = new();
    private List<TimelineLine> _allLines = new();
    private DateOnly _horizonStart;
    private DateOnly _horizonEnd;

    protected override async Task OnInitializedAsync()
    {
        var program = await Db.Programs.FirstAsync();
        (_horizonStart, _horizonEnd) = HorizonService.GetHorizon(program);

        _scenarios = await Db.PlanningScenarios.Where(s => s.ProgramId == program.Id).ToListAsync();

        // Restore the previously-selected scenario for this session (SPEC
        // section 57), falling back to the baseline scenario on first visit.
        if (FilterState.ScenarioId is null || !_scenarios.Any(s => s.Id == FilterState.ScenarioId))
        {
            FilterState.ScenarioId = _scenarios.FirstOrDefault(s => s.IsBaseline)?.Id ?? _scenarios.First().Id;
        }

        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _allLines = await GanttService.GetTimelineLinesAsync(FilterState.ScenarioId!.Value);
    }

    private List<GanttBar> FilteredBars()
    {
        IEnumerable<TimelineLine> query = _allLines;

        if (!string.IsNullOrWhiteSpace(FilterState.TemplateFilter))
            query = query.Where(l => (l.TemplateName ?? "").Contains(FilterState.TemplateFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(FilterState.WorkstreamFilter))
            query = query.Where(l => (l.WorkstreamName ?? "").Contains(FilterState.WorkstreamFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(FilterState.TeamFilter))
            query = query.Where(l => l.TeamName.Contains(FilterState.TeamFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(FilterState.RoleFilter))
            query = query.Where(l => l.RoleName.Contains(FilterState.RoleFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(FilterState.PersonFilter))
            query = query.Where(l => (l.PersonName ?? "").Contains(FilterState.PersonFilter, StringComparison.OrdinalIgnoreCase));
        if (FilterState.OpenDemandOnly)
            query = query.Where(l => l.IsOpenDemand);

        return query.Select(l => new GanttBar
        {
            Id = l.Id,
            GroupLabel = GroupLabelFor(FilterState.GroupBy, l),
            SubGroupLabel = FilterState.GroupBy2 == "None" ? null : GroupLabelFor(FilterState.GroupBy2, l),
            BarLabel = $"{l.TeamName} · {l.RoleName} · {l.Fte:0.##} FTE",
            SubLabel = l.PersonName,
            StartDate = l.StartDate,
            EndDate = l.EndDate,
            Color = l.IsOpenDemand ? "open" : "filled"
        }).ToList();
    }

    private string GroupLabelFor(string groupBy, TimelineLine l) => groupBy switch
    {
        "Template" => l.TemplateName ?? "(no template)",
        "Phase" => l.PhaseName ?? "(no phase)",
        "Workstream" => l.WorkstreamName ?? "(no workstream)",
        "Team" => l.TeamName,
        "Role" => l.RoleName,
        "Person" => l.PersonName ?? "(open demand)",
        _ => "(all)"
    };
}
