@page "/resource-plan"
@rendermode InteractiveServer
@inject WmsResourcePlanner.Application.Interfaces.IAppDbContext Db
@inject WmsResourcePlanner.Application.Services.ResourcePlanGridService GridService
@inject WmsResourcePlanner.Application.Services.ScenarioService ScenarioService
@inject WmsResourcePlanner.Application.Services.ValidationService ValidationService
@inject WmsResourcePlanner.Application.Services.HorizonService HorizonService
@inject WmsResourcePlanner.Application.Services.LookupService Lookup
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using WmsResourcePlanner.Domain.Entities

<PageTitle>Resource Plan</PageTitle>
<h1>Resource Plan</h1>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <div class="toolbar">
        <label>Scenario:
            <select @bind="_scenarioId" @bind:after="LoadAsync">
                @foreach (var s in _scenarios)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </label>
        <span class="save-status">@_status</span>
        <button class="btn secondary" @onclick="DuplicateScenarioAsync">Duplicate Scenario</button>
        <UndoBar OnUndone="LoadAsync" />
        <label><input type="checkbox" @bind="_showTemplateColumn" /> Template column</label>
        <label><input type="checkbox" @bind="_showWorkstreamColumn" /> Workstream column</label>
        <label><input type="checkbox" @bind="_showPhaseOverlay" /> Show templates/phases overlay</label>
        <span style="margin-left:auto">Horizon: @_horizonStart.ToString("MMM yyyy") – @_horizonEnd.ToString("MMM yyyy") (<a href="/settings">change</a>)</span>
    </div>

    <div class="toolbar" style="flex-wrap:wrap">
        <label>Team: <input @bind="_filterTeam" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Template: <input @bind="_filterTemplate" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Workstream: <input @bind="_filterWorkstream" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Role: <input @bind="_filterRole" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <label>Person: <input @bind="_filterPerson" @bind:event="oninput" placeholder="contains..." style="width:110px" /></label>
        <span>Showing @FilteredRows().Count of @_rows.Count row(s).</span>
    </div>

    <div class="grid-scroll" id="@_gridContainerId" data-row-cols="@(FrozenColumnCount + _monthHeaders.Count)">
        <table class="data-grid frozen-grid" style="width:@(TotalGridWidth)px">
            <thead>
                <tr style="height:@(HeaderRowHeight)px">
                    <th class="frozen-col" style="left:@(TeamLeft)px;width:@(TeamColWidth)px;top:0">Team</th>
                    @if (_showTemplateColumn)
                    {
                        <th class="frozen-col" style="left:@(TemplateLeft)px;width:@(TemplateColWidth)px;top:0">Template</th>
                    }
                    @if (_showWorkstreamColumn)
                    {
                        <th class="frozen-col" style="left:@(WorkstreamLeft)px;width:@(WorkstreamColWidth)px;top:0">Workstream</th>
                    }
                    <th class="frozen-col" style="left:@(RoleLeft)px;width:@(RoleColWidth)px;top:0">Role</th>
                    <th class="frozen-col frozen-col-last" style="left:@(PersonLeft)px;width:@(PersonColWidth)px;top:0">Person</th>
                    @foreach (var m in _monthHeaders)
                    {
                        <th class="month-col" style="top:0">@m.ToString("MMM-yy")</th>
                    }
                </tr>
                @if (_showPhaseOverlay)
                {
                    @foreach (var row in OverlayRows())
                    {
                        <tr class="overlay-row" style="height:@(HeaderRowHeight)px">
                            @if (row.TemplateLabel is not null)
                            {
                                <th class="frozen-col overlay-label" rowspan="@row.TemplateRowSpan" colspan="@FrozenColumnCount" style="left:0px;width:@(TotalFrozenWidth)px;top:@(row.Top)px" title="@row.TemplateLabel">@row.TemplateLabel</th>
                            }
                            @foreach (var seg in row.Segments)
                            {
                                @if (seg.Color is null)
                                {
                                    <th class="month-col overlay-cell overlay-gap" colspan="@seg.Span" style="top:@(row.Top)px"></th>
                                }
                                else
                                {
                                    <th class="month-col overlay-cell" colspan="@seg.Span" style="top:@(row.Top)px;background:@(seg.Color);color:#fff" title="@seg.Title">@seg.Label</th>
                                }
                            }
                        </tr>
                    }
                }
            </thead>
            <tbody>
                <tr class="new-row" @key="NewRowKey">
                    <td class="frozen-col" style="left:@(TeamLeft)px;width:@(TeamColWidth)px">
                        <select class="grid-nav-cell" value="@(_newTeamId?.ToString() ?? "")" @onchange="OnNewTeamChangedAsync">
                            <option value="">Team...</option>
                            @foreach (var t in _teams) { <option value="@t.Id">@t.Name</option> }
                            <option value="__new__">+ Add new...</option>
                        </select>
                    </td>
                    @if (_showTemplateColumn)
                    {
                        <td class="frozen-col" style="left:@(TemplateLeft)px;width:@(TemplateColWidth)px">
                            <select class="grid-nav-cell" @bind="_newAssignmentId">
                                <option value="">(none)</option>
                                @foreach (var a in _allAssignments) { <option value="@a.Id">@AssignmentLabel(a)</option> }
                            </select>
                        </td>
                    }
                    @if (_showWorkstreamColumn)
                    {
                        <td class="frozen-col" style="left:@(WorkstreamLeft)px;width:@(WorkstreamColWidth)px">
                            <select class="grid-nav-cell" value="@(_newWorkstreamId?.ToString() ?? "")" @onchange="OnNewWorkstreamChangedAsync">
                                <option value="">(none)</option>
                                @foreach (var w in _workstreams) { <option value="@w.Id">@w.Name</option> }
                                <option value="__new__">+ Add new...</option>
                            </select>
                        </td>
                    }
                    <td class="frozen-col" style="left:@(RoleLeft)px;width:@(RoleColWidth)px">
                        <select class="grid-nav-cell" value="@(_newRoleId?.ToString() ?? "")" @onchange="OnNewRoleChangedAsync">
                            <option value="">Role...</option>
                            @foreach (var r in _roles) { <option value="@r.Id">@r.Name</option> }
                            <option value="__new__">+ Add new...</option>
                        </select>
                    </td>
                    <td class="frozen-col frozen-col-last" style="left:@(PersonLeft)px;width:@(PersonColWidth)px">
                        <select class="grid-nav-cell" value="@(_newPersonId?.ToString() ?? "")" @onchange="OnNewPersonChangedAsync">
                            <option value="">(open demand)</option>
                            @foreach (var p in _people) { <option value="@p.Id">@p.DisplayName</option> }
                            <option value="__new__">+ Add new...</option>
                        </select>
                    </td>
                    @foreach (var m in _monthHeaders)
                    {
                        <td class="month-col @(_newRowBlocked ? "cell-warning" : "")" title="@(_newRowBlocked ? "Select a Team and Role first" : null)">
                            <input type="number" step="0.05" min="0" class="fte-input" style="text-align:right" @key="(m.Year, m.Month, _newRowGeneration)"
                                   @onchange="e => OnNewRowCellChangedAsync(m.Year, m.Month, e.Value)" />
                        </td>
                    }
                </tr>
                @foreach (var row in FilteredRows())
                {
                    <tr @key="row.Key">
                        <td class="frozen-col" style="left:@(TeamLeft)px;width:@(TeamColWidth)px">
                            <select class="grid-nav-cell" value="@row.Key.TeamId" @onchange="e => OnRowTeamChangedAsync(row, e)">
                                @foreach (var t in _teams) { <option value="@t.Id">@t.Name</option> }
                                <option value="__new__">+ Add new...</option>
                            </select>
                        </td>
                        @if (_showTemplateColumn)
                        {
                            <td class="frozen-col" style="left:@(TemplateLeft)px;width:@(TemplateColWidth)px">
                                <select class="grid-nav-cell" value="@(row.Key.TeamTemplateAssignmentId?.ToString() ?? "")" @onchange="e => OnRowAssignmentChangedAsync(row, e)">
                                    <option value="">(none)</option>
                                    @foreach (var a in _allAssignments) { <option value="@a.Id">@AssignmentLabel(a)</option> }
                                </select>
                            </td>
                        }
                        @if (_showWorkstreamColumn)
                        {
                            <td class="frozen-col" style="left:@(WorkstreamLeft)px;width:@(WorkstreamColWidth)px">
                                <select class="grid-nav-cell" value="@(row.Key.WorkstreamId?.ToString() ?? "")" @onchange="e => OnRowWorkstreamChangedAsync(row, e)">
                                    <option value="">(none)</option>
                                    @foreach (var w in _workstreams) { <option value="@w.Id">@w.Name</option> }
                                    <option value="__new__">+ Add new...</option>
                                </select>
                            </td>
                        }
                        <td class="frozen-col" style="left:@(RoleLeft)px;width:@(RoleColWidth)px">
                            <select class="grid-nav-cell" value="@row.Key.RoleId" @onchange="e => OnRowRoleChangedAsync(row, e)">
                                @foreach (var r in _roles) { <option value="@r.Id">@r.Name</option> }
                                <option value="__new__">+ Add new...</option>
                            </select>
                        </td>
                        <td class="frozen-col frozen-col-last" style="left:@(PersonLeft)px;width:@(PersonColWidth)px">
                            <select class="grid-nav-cell" value="@(row.Key.PersonId?.ToString() ?? "")" @onchange="e => OnRowPersonChangedAsync(row, e)">
                                <option value="">(open demand)</option>
                                @foreach (var p in _people) { <option value="@p.Id">@p.DisplayName</option> }
                                <option value="__new__">+ Add new...</option>
                            </select>
                        </td>
                        @foreach (var mv in row.Months)
                        {
                            var warning = GetWarning(row.Key, mv.Year, mv.Month);
                            <td class="month-col @(warning is null ? "" : "cell-warning")" title="@warning">
                                <input type="number" step="0.05" min="0" class="fte-input" style="text-align:right"
                                       value="@(mv.Fte == 0 ? "" : mv.Fte.ToString("0.##"))"
                                       @onchange="e => OnCellChangedAsync(row, mv.Year, mv.Month, e.Value)" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private int _programId;
    private int _scenarioId;
    private List<PlanningScenario> _scenarios = new();
    private List<ResourcePlanGridRow> _rows = new();
    private List<WmsResourcePlanner.Application.Services.GridWarning> _warnings = new();
    private List<DateOnly> _monthHeaders = new();
    private DateOnly _horizonStart;
    private DateOnly _horizonEnd;
    private string _status = string.Empty;
    private readonly string _gridContainerId = $"resource-plan-grid-{Guid.NewGuid():N}";
    private const string NewRowKey = "new-row";

    private List<Team> _teams = new();
    private List<Role> _roles = new();
    private List<Person> _people = new();
    private List<Workstream> _workstreams = new();
    private List<TeamTemplateAssignment> _allAssignments = new();
    private List<Template> _templates = new();

    // The Template dropdown intentionally lists every TeamTemplateAssignment
    // in the program (not just the ones belonging to the row's current
    // team) so a row can always be freely reassigned to any team/template
    // combination. Since assignments now span every team, the label
    // includes the team name to disambiguate identically-named templates
    // assigned to different teams.
    private static string AssignmentLabel(TeamTemplateAssignment a) => $"{a.Template?.Name} ({a.Team?.Name})";

    private int? _newTeamId;
    private int? _newAssignmentId;
    private int? _newRoleId;
    private int? _newPersonId;
    private int? _newWorkstreamId;

    // Text filters (case-insensitive "contains") applied to the currently
    // loaded rows, mirroring the Global Timeline filter pattern.
    private string _filterTeam = string.Empty;
    private string _filterTemplate = string.Empty;
    private string _filterWorkstream = string.Empty;
    private string _filterRole = string.Empty;
    private string _filterPerson = string.Empty;

    // Frozen (sticky) leading-column widths and the "collapse column" toggles
    // that let the user hide the optional Template/Workstream columns to
    // free up horizontal space for the scrolling month data.
    private bool _showTemplateColumn = true;
    private bool _showWorkstreamColumn = true;
    private bool _showPhaseOverlay;
    private const int TeamColWidth = 140;
    private const int TemplateColWidth = 100;
    private const int WorkstreamColWidth = 120;
    private const int RoleColWidth = 120;
    private const int PersonColWidth = 130;

    private int TeamLeft => 0;
    private int TemplateLeft => TeamLeft + TeamColWidth;
    private int WorkstreamLeft => TemplateLeft + (_showTemplateColumn ? TemplateColWidth : 0);
    private int RoleLeft => WorkstreamLeft + (_showWorkstreamColumn ? WorkstreamColWidth : 0);
    private int PersonLeft => RoleLeft + RoleColWidth;
    private const int MonthColWidth = 56;
    private const int HeaderRowHeight = 30;

    private int FrozenColumnCount => 3 + (_showTemplateColumn ? 1 : 0) + (_showWorkstreamColumn ? 1 : 0);
    private int TotalFrozenWidth => PersonLeft + PersonColWidth;

    // table-layout:fixed only reliably fixes each column's rendered width
    // (rather than falling back to content-based auto sizing, which is what
    // caused the gaps/overlaps between the frozen columns and the month
    // data) when the <table> itself has an explicit, non-auto width equal
    // to the sum of all its column widths.
    private int TotalGridWidth => TotalFrozenWidth + (_monthHeaders.Count * MonthColWidth);

    protected override async Task OnInitializedAsync()
    {
        var program = await Db.Programs.FirstAsync();
        _programId = program.Id;
        (_horizonStart, _horizonEnd) = HorizonService.GetHorizon(program);

        _scenarios = await Db.PlanningScenarios.Where(s => s.ProgramId == _programId).ToListAsync();
        _scenarioId = _scenarios.FirstOrDefault(s => s.IsBaseline)?.Id ?? _scenarios.First().Id;

        await ReloadLookupsAsync();
        _templates = await Db.Templates.Where(t => t.ProgramId == _programId).Include(t => t.Phases).ToListAsync();

        var monthCount = WmsResourcePlanner.Application.Services.HorizonService.MonthSpan(_horizonStart, _horizonEnd);
        for (var i = 0; i < monthCount; i++)
        {
            _monthHeaders.Add(_horizonStart.AddMonths(i));
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("wmsGridNav.init", _gridContainerId);
        }
    }

    private async Task ReloadLookupsAsync()
    {
        _teams = await Db.Teams.Where(t => t.ProgramId == _programId).OrderBy(t => t.Name).ToListAsync();
        _roles = await Db.Roles.Where(r => r.ProgramId == _programId).OrderBy(r => r.Name).ToListAsync();
        _people = await Db.People.Where(p => p.ProgramId == _programId).OrderBy(p => p.DisplayName).ToListAsync();
        _workstreams = await Db.Workstreams.Where(w => w.ProgramId == _programId).OrderBy(w => w.Name).ToListAsync();
        _allAssignments = await Db.TeamTemplateAssignments.Include(a => a.Template).Include(a => a.Team)
            .OrderBy(a => a.Template!.Name).ThenBy(a => a.Team!.Name).ToListAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await GridService.GetGridAsync(_scenarioId, _horizonStart, _horizonEnd);
        _warnings = await ValidationService.GetWarningsAsync(_scenarioId, _horizonStart, _horizonEnd);
        _loading = false;
    }

    private List<ResourcePlanGridRow> FilteredRows()
    {
        IEnumerable<ResourcePlanGridRow> query = _rows;

        if (!string.IsNullOrWhiteSpace(_filterTeam))
            query = query.Where(r => r.TeamName.Contains(_filterTeam, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_filterTemplate))
            query = query.Where(r => (r.TemplateName ?? "").Contains(_filterTemplate, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_filterWorkstream))
            query = query.Where(r => (r.WorkstreamName ?? "").Contains(_filterWorkstream, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_filterRole))
            query = query.Where(r => r.RoleName.Contains(_filterRole, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_filterPerson))
            query = query.Where(r => (r.PersonName ?? "").Contains(_filterPerson, StringComparison.OrdinalIgnoreCase));

        return query.ToList();
    }

    private string? GetWarning(ResourcePlanRowKey key, int year, int month)
    {
        var matches = _warnings.Where(w => w.Key == key && w.Year == year && w.Month == month).ToList();
        return matches.Count == 0 ? null : string.Join(" ", matches.Select(m => m.Message));
    }

    private async Task DuplicateScenarioAsync()
    {
        var source = _scenarios.First(s => s.Id == _scenarioId);
        var copy = await ScenarioService.DuplicateAsync(_scenarioId, $"{source.Name} (Copy)");
        _scenarios.Add(copy);
        _scenarioId = copy.Id;
        _status = $"Duplicated \"{source.Name}\" into \"{copy.Name}\".";
        await LoadAsync();
    }

    private async Task OnCellChangedAsync(ResourcePlanGridRow row, int year, int month, object? value)
    {
        var text = value?.ToString();
        if (!TryParseFte(text, out var fte))
        {
            _status = $"\"{text}\" is not a valid FTE value.";
            return;
        }

        await GridService.UpdateCellAsync(_programId, row.Key, _horizonStart, _horizonEnd, year, month, fte);
        _status = $"Saved at {DateTime.Now:T}";
        await LoadAsync();
    }

    // True once the user has typed an FTE value into the always-present
    // new row without first choosing a Team and Role - used to visually
    // flag the month cells so a blocked save is obvious rather than a
    // silent no-op (previously only a small toolbar status line changed).
    private bool _newRowBlocked;

    // FTE values typed into the new row's month cells before a Team and
    // Role have both been chosen. Previously these were simply discarded:
    // once the user picked Team/Role afterwards the warning highlight
    // cleared, giving the impression the already-typed value had been
    // saved, when in fact it had been silently dropped and nothing ever
    // re-submitted it. Now the value is held here and automatically
    // flushed (saved) the moment Team+Role both become available.
    private readonly Dictionary<(int Year, int Month), decimal> _newRowPending = new();

    // Bumped after every successful flush so the new-row's month <input>
    // elements are re-keyed and recreated by Blazor (clearing any stale
    // typed text left in the DOM) - these inputs are intentionally left
    // unbound/uncontrolled otherwise, so nothing else would ever clear them.
    private int _newRowGeneration;

    private async Task OnNewRowCellChangedAsync(int year, int month, object? value)
    {
        var text = value?.ToString();
        if (!TryParseFte(text, out var fte))
        {
            _status = $"\"{text}\" is not a valid FTE value.";
            return;
        }

        if (_newTeamId is null || _newRoleId is null)
        {
            if (fte == 0m)
            {
                _newRowPending.Remove((year, month));
            }
            else
            {
                _newRowPending[(year, month)] = fte;
                _newRowBlocked = true;
                _status = "Select a Team and Role, and the value(s) you entered will be saved automatically.";
            }
            return;
        }
        if (fte == 0m) return;

        _newRowPending[(year, month)] = fte;
        await FlushNewRowPendingAsync();
    }

    // Saves every pending month value once both Team and Role are set,
    // whether they arrived via the FTE cells (blocked earlier) or the
    // Team/Role dropdowns being chosen after the FTE was already typed.
    private async Task FlushNewRowPendingAsync()
    {
        if (_newTeamId is null || _newRoleId is null || _newRowPending.Count == 0) return;

        var key = new ResourcePlanRowKey(_scenarioId, _newTeamId.Value, _newAssignmentId, null, _newWorkstreamId, null, _newRoleId.Value, _newPersonId);
        foreach (var ((year, month), fte) in _newRowPending)
        {
            await GridService.UpdateCellAsync(_programId, key, _horizonStart, _horizonEnd, year, month, fte);
        }
        _status = $"Added new row, saved at {DateTime.Now:T}";

        // Resetting these fields (rather than converting this <tr> into a
        // regular row) is what keeps a fresh, always-present blank row at
        // the top of the grid ready for the next entry.
        _newTeamId = null; _newAssignmentId = null; _newRoleId = null; _newPersonId = null; _newWorkstreamId = null;
        _newRowBlocked = false;
        _newRowPending.Clear();
        _newRowGeneration++;
        await LoadAsync();
    }

    // input[type=number] always yields either an empty string or a
    // dot-decimal value (e.g. "0.5"), regardless of the server's current
    // culture - parsing with CultureInfo.InvariantCulture (rather than the
    // culture-sensitive decimal.Parse used previously) avoids a
    // FormatException - and a silently-aborted save with no visible error -
    // on any server whose culture expects a different decimal separator.
    private static bool TryParseFte(string? text, out decimal fte)
    {
        if (string.IsNullOrWhiteSpace(text)) { fte = 0m; return true; }
        return decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out fte);
    }

    // ---- Inline editing of the leading (frozen) columns for existing rows.
    // Each handler re-points the row's underlying ResourcePlanLines to the
    // newly chosen value via UpdateRowContextAsync. Selecting "+ Add new..."
    // creates the entity on the fly via LookupService (SPEC.md section 5:
    // "learn as the user works").

    private async Task OnRowTeamChangedAsync(ResourcePlanGridRow row, ChangeEventArgs e)
    {
        var (proceed, teamId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreateTeamAsync(_programId, name), t => t.Id);
        if (!proceed || teamId is null) { StateHasChanged(); return; }
        await GridService.UpdateRowContextAsync(row.Key, teamId.Value, row.Key.TeamTemplateAssignmentId, row.Key.WorkstreamId, row.Key.RoleId, row.Key.PersonId);
        _status = $"Saved at {DateTime.Now:T}";
        await LoadAsync();
    }

    private async Task OnRowAssignmentChangedAsync(ResourcePlanGridRow row, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? assignmentId = string.IsNullOrEmpty(raw) ? null : int.Parse(raw);
        await GridService.UpdateRowContextAsync(row.Key, row.Key.TeamId, assignmentId, row.Key.WorkstreamId, row.Key.RoleId, row.Key.PersonId);
        _status = $"Saved at {DateTime.Now:T}";
        await LoadAsync();
    }

    private async Task OnRowWorkstreamChangedAsync(ResourcePlanGridRow row, ChangeEventArgs e)
    {
        var (proceed, workstreamId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreateWorkstreamAsync(_programId, name), w => w.Id);
        if (!proceed) { StateHasChanged(); return; }
        await GridService.UpdateRowContextAsync(row.Key, row.Key.TeamId, row.Key.TeamTemplateAssignmentId, workstreamId, row.Key.RoleId, row.Key.PersonId);
        _status = $"Saved at {DateTime.Now:T}";
        await LoadAsync();
    }

    private async Task OnRowRoleChangedAsync(ResourcePlanGridRow row, ChangeEventArgs e)
    {
        var (proceed, roleId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreateRoleAsync(_programId, name), r => r.Id);
        if (!proceed || roleId is null) { StateHasChanged(); return; }
        await GridService.UpdateRowContextAsync(row.Key, row.Key.TeamId, row.Key.TeamTemplateAssignmentId, row.Key.WorkstreamId, roleId.Value, row.Key.PersonId);
        _status = $"Saved at {DateTime.Now:T}";
        await LoadAsync();
    }

    private async Task OnRowPersonChangedAsync(ResourcePlanGridRow row, ChangeEventArgs e)
    {
        var (proceed, personId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreatePersonAsync(_programId, name), p => p.Id);
        if (!proceed) { StateHasChanged(); return; }
        await GridService.UpdateRowContextAsync(row.Key, row.Key.TeamId, row.Key.TeamTemplateAssignmentId, row.Key.WorkstreamId, row.Key.RoleId, personId);
        _status = $"Saved at {DateTime.Now:T}";
        await LoadAsync();
    }

    // ---- Inline editing for the always-present blank "add row" at the
    // top of the grid (SPEC.md section 4: "quick-add rows").

    private async Task OnNewTeamChangedAsync(ChangeEventArgs e)
    {
        var (proceed, teamId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreateTeamAsync(_programId, name), t => t.Id);
        if (proceed) _newTeamId = teamId;
        if (_newTeamId is not null && _newRoleId is not null) await FlushNewRowPendingAsync();
    }

    private async Task OnNewWorkstreamChangedAsync(ChangeEventArgs e)
    {
        var (proceed, workstreamId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreateWorkstreamAsync(_programId, name), w => w.Id);
        if (proceed) _newWorkstreamId = workstreamId;
    }

    private async Task OnNewRoleChangedAsync(ChangeEventArgs e)
    {
        var (proceed, roleId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreateRoleAsync(_programId, name), r => r.Id);
        if (proceed) _newRoleId = roleId;
        if (_newTeamId is not null && _newRoleId is not null) await FlushNewRowPendingAsync();
    }

    private async Task OnNewPersonChangedAsync(ChangeEventArgs e)
    {
        var (proceed, personId) = await ResolveOrCreateAsync(e.Value?.ToString(), name => Lookup.GetOrCreatePersonAsync(_programId, name), p => p.Id);
        if (proceed) _newPersonId = personId;
    }

    /// <summary>
    /// Shared helper for every editable lookup dropdown. "__new__" prompts
    /// for a name (via the browser's native prompt()) and creates the
    /// entity through LookupService (case-insensitive get-or-create),
    /// refreshing the cached lookup lists; any other value parses as the
    /// selected entity's id; empty means "none" (null). Proceed is false
    /// only when the user cancels the "+ Add new..." prompt, so callers can
    /// leave the row unchanged instead of clearing the field to "none".
    /// </summary>
    private async Task<(bool Proceed, int? Id)> ResolveOrCreateAsync<T>(string? raw, Func<string, Task<T>> createAsync, Func<T, int> idOf)
    {
        if (raw == "__new__")
        {
            var name = await JS.InvokeAsync<string?>("prompt", "New name:");
            if (string.IsNullOrWhiteSpace(name)) return (false, null);
            var created = await createAsync(name.Trim());
            await ReloadLookupsAsync();
            return (true, idOf(created));
        }

        return (true, string.IsNullOrEmpty(raw) ? null : int.Parse(raw));
    }

    // ---- Optional Template/Phase overlay shown fixed at the top of the
    // grid so template and phase timelines can be visually compared against
    // the resource plan underneath, regardless of vertical scroll position.
    // Each template gets its own row (or several, if its phases overlap in
    // time); each phase is drawn as a single colored "merged" cell spanning
    // its month range, not repeated per-month, matching the Gantt-style
    // overlap/lane rule used elsewhere (GanttChart.AssignLanes).

    private static string ColorFor(string name) => WmsResourcePlanner.Application.Services.NameColorPalette.ColorFor(name);

    // A month-index-spanning cell within an overlay row: Color/Label are
    // null for an empty gap segment (rendered as a plain spacer cell).
    private sealed record OverlaySegment(int Span, string? Label, string? Color, string? Title);

    private sealed record OverlayRow(string? TemplateLabel, int TemplateRowSpan, List<OverlaySegment> Segments, int Top);

    // Month index of a date relative to the horizon start (can be negative
    // or beyond the last index if the date falls outside the loaded
    // _monthHeaders range - callers clip to [0, _monthHeaders.Count-1]).
    private int MonthIndexOf(DateOnly date) =>
        (date.Year - _horizonStart.Year) * 12 + (date.Month - _horizonStart.Month);

    private List<OverlayRow> OverlayRows()
    {
        var result = new List<OverlayRow>();
        if (_monthHeaders.Count == 0) return result;

        var rowIndex = 0;
        foreach (var t in _templates.OrderBy(t => t.Name))
        {
            var bars = new List<(int Start, int End, string Label, string Color, string Title)>();
            foreach (var p in t.Phases)
            {
                var start = Math.Max(0, MonthIndexOf(p.StartDate));
                var end = Math.Min(_monthHeaders.Count - 1, MonthIndexOf(p.EndDate));
                if (start > end) continue; // phase falls entirely outside the current horizon
                bars.Add((start, end, p.Name, ColorFor(p.Name), $"{t.Name}: {p.Name}"));
            }
            if (bars.Count == 0) continue;

            bars = bars.OrderBy(b => b.Start).ToList();

            // Greedy interval-partitioning lane assignment: a phase joins
            // the first lane whose last-placed phase ends before this one
            // starts (no time overlap); otherwise it starts a new lane.
            // This is the same overlap rule GanttChart uses for live-edited
            // Gantt bars, applied here at month-index granularity.
            var laneEnds = new List<int>();
            var lane = new int[bars.Count];
            for (var i = 0; i < bars.Count; i++)
            {
                var idx = laneEnds.FindIndex(end => end < bars[i].Start);
                if (idx == -1)
                {
                    laneEnds.Add(bars[i].End);
                    lane[i] = laneEnds.Count - 1;
                }
                else
                {
                    laneEnds[idx] = bars[i].End;
                    lane[i] = idx;
                }
            }

            var laneCount = laneEnds.Count;
            var laneRows = new List<List<OverlaySegment>>();
            for (var l = 0; l < laneCount; l++)
            {
                var laneBars = bars.Where((b, i) => lane[i] == l).OrderBy(b => b.Start).ToList();
                var segments = new List<OverlaySegment>();
                var cursor = 0;
                foreach (var bar in laneBars)
                {
                    if (bar.Start > cursor)
                    {
                        segments.Add(new OverlaySegment(bar.Start - cursor, null, null, null));
                    }
                    segments.Add(new OverlaySegment(bar.End - bar.Start + 1, bar.Label, bar.Color, bar.Title));
                    cursor = bar.End + 1;
                }
                if (cursor < _monthHeaders.Count)
                {
                    segments.Add(new OverlaySegment(_monthHeaders.Count - cursor, null, null, null));
                }
                laneRows.Add(segments);
            }

            for (var l = 0; l < laneRows.Count; l++)
            {
                var top = HeaderRowHeight * (1 + rowIndex);
                result.Add(new OverlayRow(l == 0 ? t.Name : null, laneRows.Count, laneRows[l], top));
                rowIndex++;
            }
        }

        return result;
    }
}

