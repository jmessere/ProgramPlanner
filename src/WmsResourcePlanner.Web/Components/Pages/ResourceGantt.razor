@page "/gantt/resources"
@rendermode InteractiveServer
@inject WmsResourcePlanner.Application.Services.GanttService GanttService
@inject WmsResourcePlanner.Application.Interfaces.IAppDbContext Db
@inject WmsResourcePlanner.Application.Services.HorizonService HorizonService
@using Microsoft.EntityFrameworkCore
@using WmsResourcePlanner.Domain.Entities

<PageTitle>Resource Gantt</PageTitle>
<h1>Resource Gantt</h1>
<p>Each bar is a resource-plan allocation (blue = named, orange = open demand). Drag to move, drag the right edge
to resize. FTE is preserved; only dates change. Editing here updates the same records shown on the Resource Plan grid.</p>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <div class="gantt-toolbar" style="flex-wrap:wrap;gap:0.5rem">
        <label>Scenario:
            <select @bind="_scenarioId" @bind:after="LoadAsync">
                @foreach (var s in _scenarios)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </label>
        <label>Person: <input @bind="_personFilter" @bind:event="oninput" placeholder="search people..." style="width:160px" /></label>
        <label><input type="checkbox" @bind="_showTemplateOverlay" /> Show template/phase overlay</label>
        <span class="save-status">@_status</span>
        <UndoBar OnUndone="LoadAsync" />
    </div>
    <p>Showing @FilteredBars().Count of @_bars.Count allocation(s).</p>
    @if (FilteredBars().Count == 0)
    {
        <p>No resource plan lines match the current filters.</p>
    }
    else
    {
        <GanttChart Bars="FilteredBars()" HorizonStart="_horizonStart" HorizonEnd="_horizonEnd"
                    GroupHeader="Person / Open Demand" OnBarChanged="OnLineChangedAsync"
                    TemplatePhaseBars="_templatePhaseBars" ShowTemplateOverlay="_showTemplateOverlay" />
    }
}

@code {
    private bool _loading = true;
    private int _scenarioId;
    private List<PlanningScenario> _scenarios = new();
    private List<WmsResourcePlanner.Application.DTOs.GanttBar> _bars = new();
    private List<WmsResourcePlanner.Application.DTOs.GanttBar> _templatePhaseBars = new();
    private DateOnly _horizonStart;
    private DateOnly _horizonEnd;
    private string _status = string.Empty;
    private string _personFilter = string.Empty;
    private bool _showTemplateOverlay;

    protected override async Task OnInitializedAsync()
    {
        var program = await Db.Programs.FirstAsync();
        (_horizonStart, _horizonEnd) = HorizonService.GetHorizon(program);

        _scenarios = await Db.PlanningScenarios.Where(s => s.ProgramId == program.Id).ToListAsync();
        _scenarioId = _scenarios.FirstOrDefault(s => s.IsBaseline)?.Id ?? _scenarios.First().Id;

        await LoadAsync();
        _templatePhaseBars = await GanttService.GetTemplatePhaseBarsAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _bars = await GanttService.GetResourcePlanLineBarsAsync(_scenarioId);
    }

    // Searches on the row's GroupLabel (the person's display name, or
    // "Open: Team / Role" for unassigned demand), so typing a person's name
    // narrows the Gantt to just their bars while still allowing "Open" to
    // surface open-demand rows.
    private List<WmsResourcePlanner.Application.DTOs.GanttBar> FilteredBars()
    {
        if (string.IsNullOrWhiteSpace(_personFilter)) return _bars;
        return _bars.Where(b => b.GroupLabel.Contains(_personFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task OnLineChangedAsync((int Id, DateOnly Start, DateOnly End) change)
    {
        await GanttService.UpdateResourcePlanLineDatesAsync(change.Id, change.Start, change.End);
        _status = $"Saved allocation dates at {DateTime.Now:T}";
        await LoadAsync();
        StateHasChanged();
    }
}
