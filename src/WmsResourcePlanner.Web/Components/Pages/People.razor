@page "/people"
@rendermode InteractiveServer
@inject WmsResourcePlanner.Application.Interfaces.IAppDbContext Db
@using Microsoft.EntityFrameworkCore
@using PersonEntity = WmsResourcePlanner.Domain.Entities.Person

<PageTitle>People</PageTitle>

<h1>People</h1>
<p class="save-status">@_status</p>

<div class="grid-scroll">
<table class="data-grid">
    <thead>
        <tr>
            <th>Display Name</th>
            <th>First</th>
            <th>Last</th>
            <th>Primary Role</th>
            <th>Employee Type</th>
            <th>Capacity FTE</th>
            <th>Organization</th>
            <th>Location</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in _people)
        {
            <tr>
                <td><input @bind="p.DisplayName" @bind:after="() => SaveAsync(p)" /> <a href="@($"/people/{p.Id}")">Detail</a></td>
                <td><input @bind="p.FirstName" @bind:after="() => SaveAsync(p)" /></td>
                <td><input @bind="p.LastName" @bind:after="() => SaveAsync(p)" /></td>
                <td>
                    <select @bind="p.PrimaryRoleId" @bind:after="() => SaveAsync(p)">
                        <option value="">(none)</option>
                        @foreach (var r in _roles)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                </td>
                <td>
                    <select @bind="p.EmployeeType" @bind:after="() => SaveAsync(p)">
                        @foreach (var t in new[] { "FTE", "Contractor", "Professional Services", "Vendor", "TBD" })
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </td>
                <td><input type="number" step="0.05" @bind="p.DefaultCapacityFte" @bind:after="() => SaveAsync(p)" /></td>
                <td><input @bind="p.Organization" @bind:after="() => SaveAsync(p)" /></td>
                <td><input @bind="p.Location" @bind:after="() => SaveAsync(p)" /></td>
                <td><input type="checkbox" @bind="p.Active" @bind:after="() => SaveAsync(p)" /></td>
            </tr>
        }
        <tr>
            <td><input placeholder="New person name..." @bind="_newName" @onkeyup="OnNewKeyUp" /></td>
            <td colspan="8"><button class="btn" @onclick="AddPersonAsync">+ Add Person</button></td>
        </tr>
    </tbody>
</table>
</div>

@code {
    private List<PersonEntity> _people = new();
    private List<WmsResourcePlanner.Domain.Entities.Role> _roles = new();
    private string _newName = string.Empty;
    private string _status = string.Empty;
    private int _programId;

    protected override async Task OnInitializedAsync()
    {
        var program = await Db.Programs.FirstAsync();
        _programId = program.Id;
        _roles = await Db.Roles.Where(r => r.ProgramId == _programId).OrderBy(r => r.Name).ToListAsync();
        _people = await Db.People.Where(p => p.ProgramId == _programId).OrderBy(p => p.DisplayName).ToListAsync();
    }

    private async Task SaveAsync(PersonEntity p)
    {
        p.ModifiedUtc = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _status = $"Saved {p.DisplayName} at {DateTime.Now:T}";
    }

    private async Task AddPersonAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        var parts = _newName.Trim().Split(' ', 2);
        var person = new PersonEntity
        {
            ProgramId = _programId,
            FirstName = parts[0],
            LastName = parts.Length > 1 ? parts[1] : string.Empty,
            DisplayName = _newName.Trim(),
            EmployeeType = "FTE",
            DefaultCapacityFte = 1.0m,
            Active = true
        };
        Db.People.Add(person);
        await Db.SaveChangesAsync();
        _people.Add(person);
        _people = _people.OrderBy(p => p.DisplayName).ToList();
        _newName = string.Empty;
        _status = $"Created {person.DisplayName}";
    }

    private async Task OnNewKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddPersonAsync();
        }
    }
}
