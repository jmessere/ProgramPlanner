@page "/gantt/templates"
@rendermode InteractiveServer
@inject WmsResourcePlanner.Application.Services.GanttService GanttService

<PageTitle>Template Gantt</PageTitle>
<h1>Template Gantt</h1>
<p>Drag a phase bar to move it; drag its right edge to resize. Changes save immediately.</p>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <div class="gantt-toolbar">
        <span class="save-status">@_status</span>
    </div>
    <GanttChart Bars="_bars" HorizonStart="_horizonStart" HorizonEnd="_horizonEnd"
                GroupHeader="Template" OnBarChanged="OnPhaseChangedAsync" />
}

@code {
    private bool _loading = true;
    private List<WmsResourcePlanner.Application.DTOs.GanttBar> _bars = new();
    private DateOnly _horizonStart;
    private DateOnly _horizonEnd;
    private string _status = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _horizonStart = new DateOnly(DateTime.Today.Year, 1, 1);
        _horizonEnd = _horizonStart.AddMonths(59);
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _bars = await GanttService.GetTemplatePhaseBarsAsync();
        foreach (var b in _bars) b.Color = "phase";
    }

    private async Task OnPhaseChangedAsync((int Id, DateOnly Start, DateOnly End) change)
    {
        await GanttService.UpdateTemplatePhaseDatesAsync(change.Id, change.Start, change.End);
        _status = $"Saved phase dates at {DateTime.Now:T}";
        await LoadAsync();
        StateHasChanged();
    }
}
